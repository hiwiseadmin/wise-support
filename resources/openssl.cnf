# WiseAdmin 随包 OpenSSL 兜底配置
#
# 用途：Windows（XAMPP/WAMP/phpstudy/BtSoft）与精简容器等环境缺少系统
# openssl.cnf 时，PHP openssl 扩展调用 openssl_pkey_new() 会报
#   error:80000003:system library::No such process
# 由 wise\support\crypto\OpenSslConfig 定位本文件并显式传入即可规避。
#
# 实测约束（改动本文件前请先看）：
# 1) 配置必须「自洽」：oid_section / distinguished_name / req_extensions /
#    x509_extensions 引用的段都必须存在；出现悬空引用时 EC 密钥生成会失败
#    （RSA 仍可能成功，容易漏测）。
# 2) 自洽前提下 RSA(2048/4096) 与 EC(prime256v1) 均可正常生成 + 导出。
# 3) 仅用于生成密钥对，不签发证书，故不配置 CA/证书扩展细节。

oid_section = new_oids

[ new_oids ]

[ req ]
default_bits       = 2048
default_md         = sha256
prompt             = no
distinguished_name = req_distinguished_name
req_extensions     = v3_req
x509_extensions    = usr_cert

[ req_distinguished_name ]
CN = WiseAdmin

[ req_attributes ]

[ usr_cert ]
basicConstraints = CA:FALSE
keyUsage         = nonRepudiation, digitalSignature, keyEncipherment

[ v3_req ]
basicConstraints = CA:FALSE
keyUsage         = nonRepudiation, digitalSignature, keyEncipherment

[ v3_ca ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical,CA:true
